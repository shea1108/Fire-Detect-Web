# =======================
# 🔧 ENVIRONMENT CONFIG
# =======================
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# =======================
# 🔐 SECRET & SECURITY
# =======================
SECRET_KEY=your_secret_key_here

# =======================
# 🛢 DATABASE
# =======================
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/fire_detect_db

# =======================
# 📧 EMAIL SETTINGS
# =======================
MAIL_MODE=development          # development = Mailtrap, production = Gmail/SendGrid
MAIL_ENABLED=True              # Set False để vô hiệu hóa gửi email

MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=noreply@firedetect.dev

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""